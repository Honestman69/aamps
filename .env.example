# ─────────────────────────────────────────────
# 注意：这里没有「LLM 主密钥」这种变量。
# API Key 用每个用户自己的 DEK 加密，DEK 由用户密码派生，
# 服务端不保存任何能解开它的材料。详见 docs/SECURITY.md 与 D003。
# 如果发现有人往这里加 LLM_MASTER_KEY 之类的配置，说明理解反了。
# ─────────────────────────────────────────────

# 数据库
# 小心：**相对路径按 `prisma/` 目录解析，不是项目根**。
# 写 `file:./data/dev.db` 会落到 `prisma/data/dev.db`，然后报 unable to open database file。
DATABASE_URL="file:../data/dev.db"

# 服务
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# 会话签名（仅用于 JWT / cookie，不参与任何数据加密）
# 必须 >= 32 字符；缺失或过短会直接拒绝启动（刻意的：给它默认值等于公开所有会话签名）。
# 换一个：node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# 注意：反向实例的 token 摘要由它派生，**换掉会让已保存的 token 失效**（见 D019）。
SESSION_SECRET="change-me-to-a-random-32-bytes-string"
SESSION_TTL_HOURS=168

# 首次启动时创建 superadmin（账号已存在则跳过，不会改密码）
# 本地开发可以直接用下面的值；部署到别人能访问的地方必须先改掉。
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD="dev-only-change-me-1234"

# OneBot 11 / NapCat
# 注意：接入地址与 token **不在这里**。它们属于业务数据，存在 BotInstance 表里，
# 由后台「实例管理」填写（见 D016）。这里放默认值会让"后台换号"这个能力名存实亡。
