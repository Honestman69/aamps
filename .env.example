# ─────────────────────────────────────────────
# 注意：这里没有「LLM 主密钥」这种变量。
# API Key 用每个用户自己的 DEK 加密，DEK 由用户密码派生，
# 服务端不保存任何能解开它的材料。详见 docs/SECURITY.md 与 D003。
# 如果发现有人往这里加 LLM_MASTER_KEY 之类的配置，说明理解反了。
# ─────────────────────────────────────────────

# 数据库
DATABASE_URL="file:./data/dev.db"

# 服务
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# 会话签名（仅用于 JWT / cookie，不参与任何数据加密）
SESSION_SECRET="change-me-to-a-random-32-bytes-string"
SESSION_TTL_HOURS=168

# 首次启动时创建 superadmin（创建成功后请清空 PASSWORD）
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=

# OneBot 11 / NapCat（M1 阶段使用）
ONEBOT_WS_URL=ws://127.0.0.1:6700/onebot/v11/ws
ONEBOT_ACCESS_TOKEN=
