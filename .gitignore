node_modules/
dist/
coverage/

# 环境变量与密钥
.env
.env.local
*.pem
*.key

# 数据库（含密文与用户数据，绝不入库）
# 注意：data 目录本身要保留（SQLite 不会自动创建目录），
# 只忽略目录内的文件，用 .gitkeep 占位。
data/*
!data/.gitkeep
*.db
*.db-shm
*.db-wal

# ── 协议端本地数据（NapCat / NTQQ） ──
# 这些目录里是 QQ 的登录会话：等同于账号控制权，不是"缓存"。
# 规则与 SECURITY.md「协议端数据目录」一节对应，配套检查：pnpm check:local-data
napcat/
napcat-data/
NapCat*/
ntqq/
qq-data/
**/.config/QQ/
**/onebot_*.json
**/ntqq_*.json

# 日志
*.log
logs/

# 编辑器
.vscode/
.idea/
.DS_Store
Thumbs.db

# WorkBuddy 本地记忆（私有，不进版本库）
.workbuddy/
